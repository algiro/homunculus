#!/bin/bash
# homunculus-sec-ufw: the only thing the homunculus-sec service may run as root (through sudo).
#
#   homunculus-sec-ufw block   <ip>   deny all traffic from <ip> (rule goes first, tagged "homunculus-sec")
#   homunculus-sec-ufw unblock <ip>   remove that rule
#
# Install as /usr/local/sbin/homunculus-sec-ufw, owner root, mode 0755. The service user must not be able to write to it.
# It checks the address itself, so a bug or compromise in the service cannot turn this into a general ufw (root) shell.

set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

[ "$#" -eq 2 ] || { echo "usage: $0 block|unblock <ip>" >&2; exit 64; }
action="$1"
ip="$2"

# Only a public, canonically written address. Private, loopback, link-local, multicast and reserved addresses are refused
# here too, so even a bad request cannot lock the administrator or the machine itself out.
local_addresses="$(/usr/sbin/ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ')"
python3 - "$ip" "$local_addresses" <<'PY' || { echo "refused: '$ip' is not a public address (or a network of at most a /24, or a /48 for IPv6) in canonical form that belongs to someone else" >&2; exit 65; }
import ipaddress, sys
text = sys.argv[1]
SPECIAL = [ipaddress.ip_network(n) for n in (
    "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24",
    "192.88.99.0/24", "192.168.0.0/16", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/4", "240.0.0.0/4",
    "::/128", "::1/128", "::ffff:0:0/96", "64:ff9b::/96", "100::/64", "2001:db8::/32", "fc00::/7", "fe80::/10", "ff00::/8")]
try:
    if "/" in text:
        net = ipaddress.ip_network(text, strict=True)         # refuses host bits set
        if str(net) != text:
            sys.exit(1)
        if net.prefixlen < (24 if net.version == 4 else 48):  # wider than this would shut out far too many visitors
            sys.exit(1)
        if net.prefixlen == net.max_prefixlen:                # one address has its own, shorter, canonical form
            sys.exit(1)
    else:
        address = ipaddress.ip_address(text)
        if str(address) != text:
            sys.exit(1)
        net = ipaddress.ip_network(address)
        if address.is_private or address.is_loopback or address.is_link_local or address.is_multicast or address.is_unspecified or address.is_reserved:
            sys.exit(1)
except ValueError:
    sys.exit(1)
if any(net.version == s.version and net.overlaps(s) for s in SPECIAL):
    sys.exit(1)
for own in sys.argv[2].split():
    try:
        if ipaddress.ip_address(own) in net:
            sys.exit(1)
    except ValueError:
        pass
PY

case "$action" in
    block)
        # Position 1 so the deny comes before any broad allow. An empty rule set has no position 1: then a plain deny.
        if ! output="$(ufw insert 1 deny from "$ip" comment homunculus-sec 2>&1)"; then
            if grep -qi 'invalid position' <<<"$output"; then
                ufw deny from "$ip" comment homunculus-sec
            else
                echo "$output" >&2
                exit 1
            fi
        else
            echo "$output"
        fi
        ;;
    unblock)
        ufw delete deny from "$ip"
        ;;
    *)
        echo "usage: $0 block|unblock <ip>" >&2
        exit 64
        ;;
esac
