# Install as /etc/sudoers.d/homunculus-sec (mode 0440, owner root) and check it with: visudo -cf /etc/sudoers.d/homunculus-sec
#
# The service runs as the unprivileged user "homunculus-sec" and may run exactly two programs as root: the wrappers, which
# validate the address themselves and then call iptables or ufw. (The service cannot write to them.)
homunculus-sec ALL=(root) NOPASSWD: /usr/local/sbin/homunculus-sec-fw, /usr/local/sbin/homunculus-sec-ufw
