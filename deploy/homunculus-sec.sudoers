# Install as /etc/sudoers.d/homunculus-sec (mode 0440, owner root) and check it with: visudo -cf /etc/sudoers.d/homunculus-sec
#
# The service runs as the unprivileged user "homunculus-sec" and may run exactly one program as root: the wrapper, which
# validates the address itself and then calls ufw. (The service cannot write to the wrapper.)
homunculus-sec ALL=(root) NOPASSWD: /usr/local/sbin/homunculus-sec-ufw
